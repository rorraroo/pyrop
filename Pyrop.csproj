<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.8.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pyrop</ToolCommandName>
    <DefaultItemExcludes>$(DefaultItemExcludes);Pyrop.Tests/**;editors/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <InternalsVisibleTo Include="Pyrop.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">
    <AssemblyMetadata Include="PyropStandalone" Value="true" />
  </ItemGroup>

</Project>
