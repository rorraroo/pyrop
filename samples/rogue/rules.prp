use dungeon "dungeon.prp"
use random library
use math library
import from dungeon Item draught blade coins supply Monster Loot Level make_level tile_at is_wall monster_at loot_at item_name item_description end
import from random roll end
import from math absolute sign end

export record Hero int x int y int health int max_health int attack int gold int depth list Item items end
export record Game Hero hero Level level list string log end

export function Game new_game int bonus block
    define Hero hero Hero
        with x 1
        with y 1
        with health add 10 bonus
        with max_health add 10 bonus
        with attack 2
        with gold 0
        with depth 1
        with items list_of Item draught end
    define Game game Game hero make_level 1 list_of string "You enter the crypt. Find the stairs down." end
    if greater bonus 0 set game said game fill "Your banked gold buys you {} extra health." list_of int bonus end
    return game
end

export function bool run_over Hero hero
    return or at_most the health of hero 0 greater the depth of hero 3

export function Game take_turn Game game string key
    if equal key "up" return step game 0 -1
    else if equal key "down" return step game 0 1
    else if equal key "left" return step game -1 0
    else if equal key "right" return step game 1 0
    else if equal key "space" return monsters_act said game "You wait."
    else return game

export function Game use_item Game game int position block
    define Hero hero the hero of game
    if or less position 0 at_least position length_of the items of hero return game
    define Item kind get the items of hero position
    set hero copy hero with items remove the items of hero position end
    match kind
        when draught block
            set hero copy hero with health smaller_of the max_health of hero add the health of hero 8 end
            return said copy game with hero hero end "You drink the draught and feel better."
        end
        when blade block
            set hero copy hero with attack add the attack of hero 1 end
            return said copy game with hero hero end "You fit the sharp blade. Your blows land harder."
        end
    end
end

export function list string pack_names Hero hero block
    define list string names list_of string end
    for Item kind in the items of hero set names push names item_name kind
    return names
end

export function string pack_detail Hero hero int position
    if and at_least position 0 less position length_of the items of hero
        return item_description get the items of hero position
    else return "Your pack is empty."

function Game said Game game string message
    return copy game with log push the log of game message end

function Game step Game game int dx int dy block
    define Hero hero the hero of game
    define int x add the x of hero dx
    define int y add the y of hero dy
    if is_wall the level of game x y return said game "A wall blocks the way."
    if_some int target monster_at the level of game x y return monsters_act strike game target
    return monsters_act arrive game x y
end

function Game strike Game game int index block
    define Level level the level of game
    define Monster monster get the monsters of level index
    define int damage roll 1 the attack of the hero of game
    define int left subtract the health of monster damage
    if greater left 0 block
        define Level hurt copy level with monsters put the monsters of level index copy monster with health left end end
        return said copy game with level hurt end fill "You hit the {} for {}." list_of string the name of monster convert string damage end
    end
    define Level cleared copy level with monsters remove the monsters of level index end
    return said copy game with level cleared end fill "You slay the {}." list_of string the name of monster end
end

function Game arrive Game game int x int y block
    define Hero hero the hero of game
    set hero copy hero with x x with y y end
    define Game moved copy game with hero hero end
    if_some int found loot_at the level of game x y set moved pick_up moved found
    if equal tile_at the level of game x y ">" return descend moved
    return moved
end

function Game pick_up Game game int index block
    define Level level the level of game
    define Loot found get the loot of level index
    define Game taken copy game with level copy level with loot remove the loot of level index end end
    define Hero hero the hero of taken
    match the treasure of found
        when coins amount block
            set hero copy hero with gold add the gold of hero amount end
            return said copy taken with hero hero end fill "You pick up {} gold." list_of int amount end
        end
        when supply kind block
            set hero copy hero with items push the items of hero kind end
            return said copy taken with hero hero end fill "You pick up a {}." list_of string item_name kind end
        end
    end
end

function Game descend Game game block
    define Hero hero the hero of game
    define int depth add the depth of hero 1
    set hero copy hero with depth depth end
    if greater depth 3 return said copy game with hero hero end "You find the crypt's back door and escape!"
    set hero copy hero with x 1 with y 1 end
    define Game deeper copy game with hero hero end
    return said copy deeper with level make_level depth end fill "You climb down to depth {}." list_of int depth end
end

function Game monsters_act Game game block
    define Game acted game
    define int index 0
    while less index length_of the monsters of the level of acted block
        if greater the health of the hero of acted 0 set acted monster_acts acted index
        set index add index 1
    end
    return acted
end

function Game monster_acts Game game int index block
    define Hero hero the hero of game
    define Level level the level of game
    define Monster monster get the monsters of level index
    define int dx subtract the x of hero the x of monster
    define int dy subtract the y of hero the y of monster
    define int distance add absolute dx absolute dy
    if equal distance 1 return hit game monster
    if greater distance 6 return game
    define int x the x of monster
    define int y the y of monster
    if at_least absolute dx absolute dy set x add x sign dx
    else set y add y sign dy
    if is_wall level x y return game
    if is_some monster_at level x y return game
    set monster copy monster with x x with y y end
    return copy game with level copy level with monsters put the monsters of level index monster end end
end

function Game hit Game game Monster monster block
    define int damage roll 1 the strength of monster
    define Hero hero the hero of game
    set hero copy hero with health subtract the health of hero damage end
    define Game hurt copy game with hero hero end
    if at_most the health of hero 0 return said hurt fill "The {} kills you." list_of string the name of monster end
    return said hurt fill "The {} hits you for {}." list_of string the name of monster convert string damage end
end
