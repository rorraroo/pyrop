use files library
import from files load save end

export record Progress int runs int escapes int best_depth int gold_banked

def int most_gold 1000000
def int most_runs 1000000

export function Progress load_progress string path block
    if_some string text attempt load path
        if_some Progress saved attempt convert Progress text
            if believable saved return saved
    return fresh_progress
end

export function bool save_progress string path Progress progress
    return attempt save path add convert string progress "\n"

export function Progress after_run Progress before int depth int gold block
    def Progress after copy before with runs add the runs of before 1
    if greater depth 3 set after copy after with escapes add the escapes of after 1
    set after copy after with best_depth larger the best_depth of after smaller depth 3
    return copy after with gold_banked smaller most_gold add the gold_banked of after gold
end

export function int health_bonus Progress progress
    return smaller 5 divide the gold_banked of progress 25

function Progress fresh_progress
    return Progress 0 0 0 0

function bool believable Progress progress block
    if or less the runs of progress 0 greater the runs of progress most_runs return false
    if or less the escapes of progress 0 greater the escapes of progress the runs of progress return false
    if or less the best_depth of progress 0 greater the best_depth of progress 3 return false
    return and at_least the gold_banked of progress 0 at_most the gold_banked of progress most_gold
end
