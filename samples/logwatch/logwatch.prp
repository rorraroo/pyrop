use tally "tally.prp"
use terminal library
use program library
use files library
import from tally Tally tally_of end
import from terminal View show read_key_within end
import from program arguments end
import from files exists load_lines end

if less length_of arguments 1 block
    write_error_line "usage: logwatch <log file>"
    exit 2
end
def string path get arguments 0
def int selected 0
def int refreshes 0

function View levels Tally counted block
    def int total the lines of counted
    return panel "Levels" rows list_of View
        bar "Info" the infos of counted total
        in_style "warning" bar "Warnings" the warnings of counted total
        in_style "danger" bar "Errors" length_of the errors of counted total
    end
end

function View file_table Tally counted block
    def string state "watching"
    if not exists path set state "missing"
    return panel "File" table list_of string "Field" "Value" end list_of list string
        list_of string "Path" path end
        list_of string "State" state end
        list_of string "Lines" convert string the lines of counted end
        list_of string "Refreshes" convert string refreshes end
    end
end

function View dashboard Tally counted
    return rows list_of View
        columns list_of View levels counted file_table counted end
        panel "Errors" menu the errors of counted selected
        in_style "muted" text "up/down select   q quit"
    end

function int moved int position string key int count block
    if equal key "down" set position add position 1
    else if equal key "up" set position subtract position 1
    else if equal key "home" set position 0
    else if equal key "end" set position subtract count 1
    return larger 0 smaller position subtract count 1
end

while true block
    def Tally counted tally_of value_or attempt load_lines path list_of string end
    set selected moved selected "" length_of the errors of counted
    set refreshes add refreshes 1
    show dashboard counted
    if_some string key read_key_within 1000 block
        if equal key "q" exit 0
        set selected moved selected key length_of the errors of counted
    end
end
