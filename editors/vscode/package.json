{
  "name": "pyrop",
  "displayName": "Pyrop",
  "description": "Syntax highlighting for the Pyrop language.",
  "version": "0.3.0",
  "publisher": "radariandev",
  "icon": "icons/pyrop-128.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pyrop",
        "aliases": [
          "Pyrop",
          "pyrop"
        ],
        "extensions": [
          ".prp"
        ],
        "icon": {
          "light": "./icons/pyrop.svg",
          "dark": "./icons/pyrop.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pyrop",
        "scopeName": "source.pyrop",
        "path": "./syntaxes/pyrop.tmLanguage.json"
      }
    ]
  }
}
