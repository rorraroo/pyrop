{
  "name": "pyrop",
  "displayName": "Pyrop",
  "description": "Pyrop language support: errors while you type, highlighting that knows functions, variables and imports.",
  "version": "1.0.0",
  "publisher": "rorraroo",
  "icon": "icons/pyrop-128.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pyrop",
        "aliases": [
          "Pyrop",
          "pyrop"
        ],
        "extensions": [
          ".prp"
        ],
        "icon": {
          "light": "./icons/pyrop.svg",
          "dark": "./icons/pyrop.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "iconThemes": [
      {
        "id": "pyrop-minimal",
        "label": "Pyrop Minimal",
        "path": "./icons/minimal/pyrop-minimal-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "pyrop",
        "scopeName": "source.pyrop",
        "path": "./syntaxes/pyrop.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Pyrop",
      "properties": {
        "pyrop.path": {
          "type": "string",
          "default": "pyrop",
          "markdownDescription": "The `pyrop` executable that runs the language server. The default finds it on `Path`."
        },
        "pyrop.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show errors while you type and colour words by what they are. Needs Pyrop 0.11.0 or later."
        }
      }
    },
    "commands": [
      {
        "command": "pyrop.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Pyrop"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "imported",
        "description": "A name that comes from another module."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "pyrop",
        "scopes": {
          "function.defaultLibrary": [
            "keyword.other.builtin.pyrop"
          ],
          "function": [
            "entity.name.function.pyrop"
          ],
          "variable": [
            "variable.other.pyrop"
          ],
          "parameter": [
            "variable.parameter.pyrop"
          ],
          "property": [
            "variable.other.member.pyrop"
          ],
          "type": [
            "entity.name.type.pyrop"
          ],
          "enumMember": [
            "variable.other.enummember.pyrop"
          ],
          "namespace": [
            "entity.name.namespace.pyrop"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[pyrop]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "*.imported:pyrop": {
            "italic": true
          }
        }
      }
    }
  }
}
