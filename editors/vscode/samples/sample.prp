# Every highlighted construct in one file
use shapes "shapes.prp"
use files library
import from shapes circle_area Size end
import from files file_exists load_lines end

export function int factorial int n
    if less n 2 return 1
    else return multiply n factorial subtract n 1

function string combine string a string b block
    define string text add a b
    return text
end

function void greet string name
    write_line add "Hi \"" add name "\"\n"

define int i 0
define float ratio divide convert float 7 2.0
define bool done false

while not done block
    set i add i 1
    if equal modulo i 2 0 continue
    if greater i 7 break
    write convert string i
end
write_line subtract 0 -7

greet add "Py" "rop"
write_line factorial 10
write_line and true or false not done
write "Name: "
write_line read
write_line "tab\there, quote \" and backslash \\"
write_line from shapes circle_area 2.0
write_line Size 2.0 3.0

function int total list int numbers map string list int groups
    return add length_of numbers length_of groups

define list string bag list_of string "lamp" "rope" end
set bag push bag "key"
define map string int prices map_of string int end
set prices put prices "lamp" 5
if has prices "lamp" write_line get prices "lamp"
write_line keys_of prices

for string item in bag block
    if equal item "rope" continue
    write_line item
end
for string name in keys_of prices write_line name

define list string words split "a,b,c" ","
write_line join words " "
if file_exists "notes.txt" for string line in load_lines "notes.txt" write_line line
for string file in from files files_in "." write_line file
styled "warning" write_error "careful: "
write_error_line "usage: sample <file>"

export record Point float x float y end
record Hero string name int health Point position list string inventory end
define Hero hero Hero "Ann" 10 Point 0.0 0.0 list_of string end
set hero copy hero with health subtract the health of hero 1 end
write_line hero

export choice Direction north east south west end
define Direction facing north
define map Direction string exits map_of Direction string south "cellar" end
if equal facing convert Direction "north" write_line facing

if_some int age attempt convert int read write_line age
else write_line "not a number"
if not attempt from files save "save.txt" "data" write_error_line "could not save"
define option Point spot none Point
write_line value_or spot Point 1.0 2.0
